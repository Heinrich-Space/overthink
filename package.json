{
  "name": "overthink",
  "version": "0.2.0",
  "description": "Overthink — Strict MCP discipline layer for AI coding agents. Blocks overthinking, wasteful commands, and unverified success claims.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "overthink": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/index.ts --http --port 3921",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http --port 3921",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "coding-agent",
    "problem-solving",
    "anti-overthinking",
    "engineering"
  ],
  "author": "missarii",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "express": "^4.21.2",
    "cors": "^2.8.5",
    "zod": "^3.24.2",
    "yaml": "^2.7.0",
    "pino": "^9.6.0",
    "commander": "^13.1.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}

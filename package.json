{
  "name": "overthink",
  "version": "0.1.0",
  "description": "Overthink — An MCP Server for Intelligent AI Problem Solving. Intelligent problem-solving control layer that transforms AI coding agents into disciplined engineering problem solvers.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "overthink": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "coding-agent",
    "problem-solving",
    "engineering",
    "debugging",
    "reasoning"
  ],
  "author": "missarii",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.24.2",
    "yaml": "^2.7.0",
    "pino": "^9.6.0",
    "commander": "^13.1.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
